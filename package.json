{
  "name": "bibel-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "oppsett": "bun scripts/stage-kvn.ts && bun install",
    "dev": "bun scripts/ensure-kvn.ts && bun --watch src/index.ts",
    "start": "bun src/index.ts",
