    "typecheck": "bun scripts/ensure-kvn.ts && tsc --noEmit"
  },
  "dependencies": {
    "@free-bible/kvn": "file:kvn-package",
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@types/bun": "^1.2.0",
    "typescript": "^5.8.0"
  }
}
